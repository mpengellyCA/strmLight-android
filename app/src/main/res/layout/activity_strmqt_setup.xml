<?xml version="1.0" encoding="utf-8"?>
<!--
    Setting up StrmQt. Two faces of one screen:
    - strmqtSimple: the default, one screen at a time (looking, the code, choosing a
      host, not found, a problem, connected), with "Advanced setup" on each;
    - strmqtAdvanced: everything else (found hosts, address and ports by hand, the
      raw pairing states, the pinned certificate, Moonlight's hosts and settings).
-->
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/strmqt_ground">

    <!-- ===================== The simple setup ===================== -->
    <LinearLayout
        android:id="@+id/strmqtSimple"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingLeft="48dp"
        android:paddingTop="27dp"
        android:paddingRight="48dp"
        android:paddingBottom="27dp">

        <include
            android:id="@+id/strmqtSimpleHeader"
            layout="@layout/strmqt_header" />

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <!-- Looking for StrmQt -->
            <LinearLayout
                android:id="@+id/strmqtScreenSearching"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/strmqtSearchingSymbol"
                    android:layout_width="120dp"
                    android:layout_height="120dp"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/strmqt_symbol" />

                <TextView
                    style="@style/StrmQt.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/strmqt_first_searching_title" />

                <TextView
                    style="@style/StrmQt.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:text="@string/strmqt_first_searching_body" />

                <ProgressBar
                    style="?android:attr/progressBarStyleHorizontal"
                    android:layout_width="260dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/strmqt_accent"
                    android:progressBackgroundTint="@color/strmqt_hairline" />

                <Button
                    android:id="@+id/strmqtSearchingAdvanced"
                    style="@style/StrmQt.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="28dp"
                    android:text="@string/strmqt_first_advanced" />
            </LinearLayout>

            <!-- The code: what to do on the left, the code on the right -->
            <LinearLayout
                android:id="@+id/strmqtScreenCode"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:baselineAligned="false"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1.1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/strmqtFirstCodeHost"
                        style="@style/StrmQt.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/strmqt_accent" />

                    <TextView
                        style="@style/StrmQt.Title"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:gravity="start"
                        android:text="@string/strmqt_first_code_title" />

                    <TextView
                        style="@style/StrmQt.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="14dp"
                        android:gravity="start"
                        android:text="@string/strmqt_first_code_where" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/strmqtStepPicture"
                            style="@style/StrmQt.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content" />

                        <TextView
                            android:id="@+id/strmqtStepRemote"
                            style="@style/StrmQt.Pill"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/strmqtFirstTrouble"
                        style="@style/StrmQt.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:minLines="1"
                        android:textColor="@color/strmqt_warning" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-5dp"
                        android:layout_marginTop="8dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/strmqtFirstNewCode"
                            style="@style/StrmQt.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/strmqt_first_new_code" />

                        <Button
                            android:id="@+id/strmqtCodeAdvanced"
                            style="@style/StrmQt.Button.Ghost"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="12dp"
                            android:text="@string/strmqt_first_advanced" />
                    </LinearLayout>
                </LinearLayout>

                <!-- As StrmQt's own pairing overlay: the code in amber Plex Mono on a panel. -->
                <FrameLayout
                    android:layout_width="0dp"
                    android:layout_height="240dp"
                    android:layout_marginLeft="40dp"
                    android:layout_weight="1"
                    android:background="@drawable/strmqt_panel">

                    <TextView
                        android:id="@+id/strmqtFirstCode"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:includeFontPadding="false"
                        android:letterSpacing="0.22"
                        android:maxLines="1"
                        android:tag="mono-bold"
                        android:textColor="@color/strmqt_accent"
                        android:textSize="96sp" />
                </FrameLayout>
            </LinearLayout>

            <!-- Several StrmQts: choose one by name -->
            <LinearLayout
                android:id="@+id/strmqtScreenChoose"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:paddingTop="8dp"
                android:visibility="gone">

                <TextView
                    style="@style/StrmQt.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strmqt_first_choose_title" />

                <TextView
                    style="@style/StrmQt.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/strmqt_first_choose_body" />

                <ScrollView
                    android:layout_width="640dp"
                    android:layout_height="0dp"
                    android:layout_marginTop="10dp"
                    android:layout_weight="1"
                    android:clipToPadding="false"
                    android:padding="14dp"
                    android:scrollbars="none">

                    <LinearLayout
                        android:id="@+id/strmqtChooseList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical" />
                </ScrollView>

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/strmqtChooseSearch"
                        style="@style/StrmQt.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/strmqt_first_search_again" />

                    <Button
                        android:id="@+id/strmqtChooseAdvanced"
                        style="@style/StrmQt.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:text="@string/strmqt_first_advanced" />
                </LinearLayout>
            </LinearLayout>

            <!-- Can't find StrmQt, or pairing stopped -->
            <LinearLayout
                android:id="@+id/strmqtScreenMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="88dp"
                    android:layout_height="88dp"
                    android:alpha="0.45"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:src="@drawable/strmqt_symbol" />

                <TextView
                    android:id="@+id/strmqtMessageTitle"
                    style="@style/StrmQt.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp" />

                <TextView
                    android:id="@+id/strmqtMessageBody"
                    style="@style/StrmQt.Body"
                    android:layout_width="720dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/strmqtMessageDetail"
                    style="@style/StrmQt.Small"
                    android:layout_width="720dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:tag="mono"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal">

                    <Button
                        android:id="@+id/strmqtMessageRetry"
                        style="@style/StrmQt.Button.Primary"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/strmqt_first_try_again" />

                    <Button
                        android:id="@+id/strmqtMessageAdvanced"
                        style="@style/StrmQt.Button.Ghost"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="12dp"
                        android:text="@string/strmqt_first_advanced" />
                </LinearLayout>
            </LinearLayout>

            <!-- Connected -->
            <LinearLayout
                android:id="@+id/strmqtScreenConnected"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="128dp"
                    android:layout_height="128dp"
                    android:background="@drawable/strmqt_ring"
                    android:contentDescription="@null"
                    android:importantForAccessibility="no"
                    android:padding="30dp"
                    android:src="@drawable/strmqt_check" />

                <TextView
                    style="@style/StrmQt.Title"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/strmqt_first_connected_title"
                    android:textSize="44sp" />

                <TextView
                    android:id="@+id/strmqtConnectedBody"
                    style="@style/StrmQt.Body"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp" />

                <TextView
                    android:id="@+id/strmqtConnectedNote"
                    style="@style/StrmQt.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_horizontal"
                    android:visibility="gone" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>

    <!-- ===================== The advanced setup ===================== -->
    <ScrollView
        android:id="@+id/strmqtAdvanced"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:visibility="gone">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingLeft="48dp"
            android:paddingTop="27dp"
            android:paddingRight="48dp"
            android:paddingBottom="27dp">

            <include
                android:id="@+id/strmqtAdvancedHeader"
                layout="@layout/strmqt_header" />

            <TextView
                style="@style/StrmQt.Title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="start"
                android:text="@string/strmqt_advanced_title"
                android:textSize="28sp" />

            <!-- Under the title, so the outcome of pairing is on screen without scrolling. -->
            <TextView
                android:id="@+id/strmqtSetupStatus"
                style="@style/StrmQt.Body"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:gravity="start"
                android:textColor="@color/strmqt_text"
                android:textSize="18sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        style="@style/StrmQt.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/strmqt_setup_host_label" />

                    <RadioGroup
                        android:id="@+id/strmqtHostGroup"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:orientation="vertical" />

                    <TextView
                        android:id="@+id/strmqtDiscoveryStatus"
                        style="@style/StrmQt.Small"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp" />

                    <Button
                        android:id="@+id/strmqtSearch"
                        style="@style/StrmQt.Button"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-5dp"
                        android:layout_marginTop="6dp"
                        android:minHeight="58dp"
                        android:text="@string/strmqt_setup_search"
                        android:textSize="18sp" />

                    <TextView
                        style="@style/StrmQt.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/strmqt_setup_address_label" />

                    <EditText
                        android:id="@+id/strmqtAddress"
                        style="@style/StrmQt.Field"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="6dp"
                        android:hint="@string/ip_hint"
                        android:inputType="textNoSuggestions" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="12dp"
                        android:baselineAligned="false"
                        android:orientation="horizontal">

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/StrmQt.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/strmqt_setup_port_label" />

                            <EditText
                                android:id="@+id/strmqtPort"
                                style="@style/StrmQt.Field"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:inputType="number"
                                android:maxLength="5"
                                android:tag="mono" />
                        </LinearLayout>

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="16dp"
                            android:layout_weight="1"
                            android:orientation="vertical">

                            <TextView
                                style="@style/StrmQt.Label"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="@string/strmqt_setup_sunshine_port_label" />

                            <EditText
                                android:id="@+id/strmqtSunshinePort"
                                style="@style/StrmQt.Field"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:inputType="number"
                                android:maxLength="5"
                                android:tag="mono" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

                <!-- The code this device shows while it pairs. Nothing is typed in here. -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="40dp"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/strmqtPairHint"
                        style="@style/StrmQt.Body"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="start"
                        android:text="@string/strmqt_setup_pair_hint"
                        android:textSize="18sp" />

                    <LinearLayout
                        android:id="@+id/strmqtCodePanel"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/strmqt_panel"
                        android:orientation="vertical"
                        android:padding="20dp"
                        android:visibility="gone">

                        <TextView
                            style="@style/StrmQt.Label"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/strmqt_setup_code_label" />

                        <TextView
                            android:id="@+id/strmqtCode"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:layout_marginBottom="4dp"
                            android:includeFontPadding="false"
                            android:letterSpacing="0.2"
                            android:tag="mono-bold"
                            android:textColor="@color/strmqt_accent"
                            android:textSize="64sp" />

                        <TextView
                            style="@style/StrmQt.Small"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/strmqt_setup_code_instructions"
                            android:textColor="@color/strmqt_text_secondary" />

                        <TextView
                            android:id="@+id/strmqtStreamStatus"
                            style="@style/StrmQt.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="12dp"
                            android:textColor="@color/strmqt_text" />

                        <TextView
                            android:id="@+id/strmqtRemoteStatus"
                            style="@style/StrmQt.Small"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="@color/strmqt_text" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginLeft="-5dp"
                        android:layout_marginTop="12dp"
                        android:orientation="horizontal">

                        <Button
                            android:id="@+id/strmqtPair"
                            style="@style/StrmQt.Button.Primary"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/strmqt_setup_pair" />

                        <Button
                            android:id="@+id/strmqtNewCode"
                            style="@style/StrmQt.Button"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginLeft="8dp"
                            android:text="@string/strmqt_setup_new_code"
                            android:visibility="gone" />
                    </LinearLayout>

                    <TextView
                        style="@style/StrmQt.Label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="16dp"
                        android:text="@string/strmqt_advanced_cert_label" />

                    <TextView
                        android:id="@+id/strmqtCert"
                        style="@style/StrmQt.Small"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:tag="mono"
                        android:textColor="@color/strmqt_text_secondary"
                        android:textSize="14sp" />
                </LinearLayout>
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:layout_marginTop="20dp"
                android:background="@color/strmqt_hairline" />

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginLeft="-5dp"
                android:layout_marginTop="12dp"
                android:orientation="horizontal">

                <Button
                    android:id="@+id/strmqtAdvancedHosts"
                    style="@style/StrmQt.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/strmqt_advanced_hosts" />

                <Button
                    android:id="@+id/strmqtAdvancedSettings"
                    style="@style/StrmQt.Button"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/strmqt_advanced_settings" />

                <Button
                    android:id="@+id/strmqtAdvancedSimple"
                    style="@style/StrmQt.Button.Ghost"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginLeft="8dp"
                    android:text="@string/strmqt_advanced_simple" />
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</FrameLayout>
