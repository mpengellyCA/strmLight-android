<?xml version="1.0" encoding="utf-8"?>
<!-- The Aperture-Q and the StrmLight wordmark, top left of each of the fork's screens. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <ImageView
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:contentDescription="@null"
        android:importantForAccessibility="no"
        android:src="@drawable/strmqt_symbol" />

    <TextView
        android:id="@+id/strmqtWordmark"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginLeft="10dp"
        android:layout_weight="1"
        android:includeFontPadding="false"
        android:tag="display"
        android:textColor="@color/strmqt_text"
        android:textSize="26sp" />

    <TextView
        android:id="@+id/strmqtPreviewBadge"
        style="@style/StrmQt.Label"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/strmqt_pill"
        android:paddingLeft="14dp"
        android:paddingTop="6dp"
        android:paddingRight="14dp"
        android:paddingBottom="6dp"
        android:text="@string/strmqt_first_preview_badge"
        android:textColor="@color/strmqt_accent"
        android:visibility="gone" />
</LinearLayout>
