<?xml version="1.0" encoding="utf-8"?>
<!-- A low-emphasis button reads as chrome until the D-pad is on it (StrmButton "ghost"). -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_enabled="false" android:color="@color/strmqt_text_disabled" />
    <item android:state_focused="true" android:color="@color/strmqt_text" />
    <item android:state_pressed="true" android:color="@color/strmqt_text" />
    <item android:color="@color/strmqt_text_tertiary" />
</selector>
