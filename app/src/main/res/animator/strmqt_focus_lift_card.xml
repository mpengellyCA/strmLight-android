<?xml version="1.0" encoding="utf-8"?>
<!-- a smaller lift than buttons, for wide cards over Theme.animFastMs, eased out: what StrmQt's buttons do when focused. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.02" android:duration="160"
                android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.02" android:duration="160"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </set>
    </item>
    <item>
        <set>
            <objectAnimator android:propertyName="scaleX" android:valueTo="1.0" android:duration="160"
                android:interpolator="@android:interpolator/decelerate_cubic" />
            <objectAnimator android:propertyName="scaleY" android:valueTo="1.0" android:duration="160"
                android:interpolator="@android:interpolator/decelerate_cubic" />
        </set>
    </item>
</selector>
