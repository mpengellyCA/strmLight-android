<?xml version="1.0" encoding="utf-8"?>
<!-- A text field: the surface with a hairline, ringed in amber while it has focus. -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_focused="true">
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/strmqt_surface_raised" />
            <stroke android:width="3dp" android:color="@color/strmqt_accent" />
            <padding android:left="14dp" android:right="14dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <corners android:radius="8dp" />
            <solid android:color="@color/strmqt_surface" />
            <stroke android:width="1dp" android:color="@color/strmqt_hairline" />
            <padding android:left="14dp" android:right="14dp" android:top="10dp" android:bottom="10dp" />
        </shape>
    </item>
</selector>
